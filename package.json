{
    "name": "angular-cheat-sheet",
    "version": "0.0.0",
    "scripts": {
        "ng": "ng",
        "start": "ng serve",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "test": "ng test",
        "e2e": "playwright test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "predev": "node scripts/ensure-fake-api.js && prettier --write . --log-level warn",
        "dev": "concurrently -k -n api,auth,ng -c cyan,yellow,magenta \"npm:api\" \"npm:api:auth\" \"npm:start\"",
        "api": "json-server --watch fake-api/db.json --port 3000",
        "api:auth": "node fake-api/auth-server.js",
        "api:slow": "json-server --watch fake-api/db.json --port 3000 --delay 1000",
        "api:reset": "node -e \"require('fs').copyFileSync('fake-api/db.seed.json','fake-api/db.json')\""
    },
    "private": true,
    "packageManager": "npm@12.2.1",
    "dependencies": {
        "@angular/common": "^22.3.0",
        "@angular/compiler": "^22.3.0",
        "@angular/core": "^22.3.0",
        "@angular/forms": "^22.3.0",
        "@angular/platform-browser": "^22.3.0",
        "@angular/router": "^22.3.0",
        "bcryptjs": "^3.0.3",
        "bootstrap": "^5.3.9",
        "highlight.js": "^11.12.0",
        "rxjs": "~7.8.0",
        "tslib": "^2.3.0"
    },
    "devDependencies": {
        "@angular/build": "^22.3.0",
        "@angular/cli": "^22.3.0",
        "@angular/compiler-cli": "^22.3.0",
        "@playwright/test": "^1.65.1",
        "concurrently": "^10.0.7",
        "jsdom": "^30.0.0",
        "json-server": "^0.17.4",
        "jsonwebtoken": "^9.0.3",
        "prettier": "^3.8.1",
        "typescript": "~6.0.2",
        "vitest": "^5.0.0"
    }
}
